# Copy this file to .env and fill in real values. Never commit .env.
DISCORD_TOKEN=your-discord-bot-token-here
CHANNEL_ID=1539333221416828981
# Optional: your server's ID. Set this for instant slash-command sync during
# development - without it, commands still work but can take up to ~1h to
# propagate globally after each change.
GUILD_ID=
# Used when /track's location argument is left blank.
DEFAULT_LOCATION=Morocco
CHECK_INTERVAL_MINUTES=15
# Bounds total request volume as the user count grows.
MAX_KEYWORDS_PER_USER=5
# Minimum seconds between /check runs (manual or scheduled) - stops spammed
# manual checks from bursting extra requests at job sites.
CHECK_COOLDOWN_SECONDS=120
DB_PATH=data/job_alerts.db

# Optional proxy (format: http://user:pass@host:port)
PROXY_URL=
